{
  "name": "@tannerbroberts/atomizer",
  "version": "0.4.0",
  "description": "CLI tool to reorganize React folder structure using AST traversal based on the Render Tree",
  "main": "index.js",
  "bin": {
    "atomizer": "./index.js"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc",
    "prepublishOnly": "npm run build",
    "test": "npm run build && vitest run",
    "test:watch": "npm run build && vitest",
    "test:coverage": "npm run build && vitest run --coverage",
    "test:ui": "npm run build && vitest --ui",
    "release": "npm run build && node scripts/publish.js"
  },
  "files": [
    "index.js",
    "src/",
    "dist/"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "react",
    "refactor",
    "ast",
    "folder-structure",
    "cli"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@typescript-eslint/typescript-estree": "^8.50.0",
    "chalk": "^4.1.2",
    "commander": "^14.0.2",
    "glob": "^13.0.0",
    "ts-morph": "^24.0.0",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/uuid": "^10.0.0",
    "@vitest/coverage-v8": "^4.0.18",
    "uuid": "^13.0.0",
    "vitest": "^4.0.18"
  }
}
